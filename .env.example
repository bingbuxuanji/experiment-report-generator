# ============================================
# 实验报告生成器 - LLM 配置
# ============================================
# 使用方法：复制此文件为 .env，填写你选择的 AI 服务
#
# 四种方式任选其一：

# 方式一：Claude API（推荐，生成质量最高）
# 获取地址：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-你的key

# 方式二：OpenAI 兼容 API（可使用任何兼容服务）
# OPENAI_API_KEY=sk-你的key
# OPENAI_BASE_URL=https://api.openai.com/v1

# 方式三：DeepSeek API（国内可用，兼容 OpenAI / Anthropic 格式）
# 获取地址：https://platform.deepseek.com/
# 可选模型: deepseek-v4-pro / deepseek-v4-flash
# --- OpenAI 兼容方式 ---
# DEEPSEEK_API_KEY=sk-你的key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# --- 也可通过 Claude 客户端走 Anthropic 兼容方式 ---
# ANTHROPIC_API_KEY=sk-你的deepseek-key
# CLAUDE_BASE_URL=https://api.deepseek.com/anthropic
# CLAUDE_MODEL=deepseek-v4-pro

# 方式四：本地 Ollama（免费，无需联网）
# 下载：https://ollama.com/download
# 安装后运行：ollama pull qwen2.5:7b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# 如果你不想配置任何 AI 服务：
# 系统会自动使用"离线模式"——通过源码插件生成基础报告框架
# ============================================
